# Masseberegning API configuration.
# Copy to .env for local use, or set these as environment variables on the
# container platform. Nothing here belongs in the frontend.

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Serve the UI from this process too. Local development only; in production the
# frontend is on GitHub Pages.
SERVE_STATIC=1

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list. Must include the GitHub Pages origin, and the
# custom domain too if you use one. Never "*" - we send credentials.
ALLOWED_ORIGINS=https://prosit.github.io,https://masseberegning.prosit.no

# --- database ---------------------------------------------------------------
# Supabase: Project settings > Database > Connection string. Use the pooled
# connection (port 6543) for a serverless/scale-to-zero container.
DATABASE_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres

# --- auth -------------------------------------------------------------------
# Preferred: asymmetric verification against the project's JWKS.
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Only for projects still on a shared HS256 secret. Leave empty if JWKS is set.
SUPABASE_JWT_SECRET=

# Bootstrap superadmins, comma-separated. These addresses get superadmin on
# sign-in with no invite. Keep this set: it is the way back in if the last
# superadmin ever loses their account.
SUPERADMIN_EMAILS=per@prosit.no

# --- invites ----------------------------------------------------------------
# Where invitation links point. Must be the frontend origin.
FRONTEND_URL=https://masseberegning.prosit.no/
INVITE_DEFAULT_DAYS=14
INVITE_MAX_DAYS=90

# --- limits -----------------------------------------------------------------
# 10 km2. A site plan is smaller than this; a box around a municipality is not
# a site plan, and the DEM fetch behind it is expensive.
MAX_AREA_M2=10000000
CALC_PER_MINUTE=6
CALC_PER_DAY=200
REDEEM_PER_HOUR=20

# --- jobs -------------------------------------------------------------------
JOB_TTL_MINUTES=120
# Leave empty for the system temp dir. Point at a mounted volume if you want
# job output to survive a restart.
JOB_ROOT=
