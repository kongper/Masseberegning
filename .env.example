# Masseberegning API configuration.
# Copy to .env for local use, or set these as environment variables on the
# container platform. Nothing here belongs in the frontend.

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Serve the UI from this process too. Local development only; in production the
# frontend is on GitHub Pages.
SERVE_STATIC=1

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of ORIGINS - scheme and host only, no path and no
# trailing slash, even though a GitHub Pages project site is served from a
# subpath. Never "*": we send credentials.
ALLOWED_ORIGINS=https://kongper.github.io

# --- database ---------------------------------------------------------------
# Supabase: Project Settings > Database > Connection string > SESSION POOLER.
#
# Not the direct connection (IPv6-only on new projects, may not resolve from
# Fly) and not the transaction pooler on 6543 (PgBouncer in transaction mode).
# The app disables psycopg's prepared statements so it survives the transaction
# pooler anyway, but session mode is the right fit for a long-lived process
# that holds its own connection pool.
DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# --- auth -------------------------------------------------------------------
# Preferred: asymmetric verification against the project's JWKS.
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Only for projects still on a shared HS256 secret. Leave empty if JWKS is set.
SUPABASE_JWT_SECRET=

# Bootstrap superadmins, comma-separated. These addresses get superadmin on
# sign-in with no invite. Keep this set: it is the way back in if the last
# superadmin ever loses their account.
SUPERADMIN_EMAILS=per@prosit.no

# --- invites ----------------------------------------------------------------
# Where invitation links point. Unlike ALLOWED_ORIGINS this DOES include the
# subpath a GitHub Pages project site is served from.
FRONTEND_URL=https://kongper.github.io/masseberegning/
INVITE_DEFAULT_DAYS=14
INVITE_MAX_DAYS=90

# --- limits -----------------------------------------------------------------
# 10 km2. A site plan is smaller than this; a box around a municipality is not
# a site plan, and the DEM fetch behind it is expensive.
MAX_AREA_M2=10000000
CALC_PER_MINUTE=6
CALC_PER_DAY=200
REDEEM_PER_HOUR=20

# --- caching ----------------------------------------------------------------
# Memory the DEM cache may hold. It competes with the working set of a single
# calculation - a 16 Mpx DEM is 64 MB at float32 and the difference array is
# 128 MB at float64 - so keep it well under the machine's RAM. 96 on a 2 GB
# Fly machine; the default of 256 assumes a roomier host.
DEM_CACHE_MB=96

# --- jobs -------------------------------------------------------------------
JOB_TTL_MINUTES=120
# Leave empty for the system temp dir. Point at a mounted volume if you want
# job output to survive a restart.
JOB_ROOT=
